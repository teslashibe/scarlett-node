# Copy to ~/.config/scarlett-node/node.env and chmod 0600
# Choose your coordinator and verifier before starting
SCARLETT_COORDINATOR=https://network.scarlett.ai
SCARLETT_PROFILE=standard
SCARLETT_EXECUTOR=services
SCARLETT_SERVICES=codex,x_read
SCARLETT_VERIFIER=verifier.example.invalid:7047
# Optional private CA for the verifier control connection only
# SCARLETT_VERIFIER_CA_FILE=/absolute/path/to/verifier-ca.pem
# Absolute local credential paths, never node credentials or wallet private keys
# SCARLETT_CODEX_HOME=/home/you/.codex
# SCARLETT_X_SESSION=/home/you/.config/scarlett-node/x-session.json
# X jobs proven by keyed relay are ON by default (far less upload than
# MPC-TLS). The verifier then holds the TLS keys for your connection to X and
# decides what is sent with your session; you are trusting it with the
# account. Prefer an account kept for this purpose over a personal one. See
# README. Set to 0 to serve MPC-TLS only.
# SCARLETT_X_RELAY=0
SCARLETT_CODEX_CONCURRENCY=1
SCARLETT_X_CONCURRENCY=1
# Add web to SCARLETT_SERVICES (for example codex,x_read,web) to fetch public
# https pages from this connection. Web needs no account.
# SCARLETT_WEB_CONCURRENCY=4
# A cloud server should send web traffic through a residential proxy. Only
# non-intercepting HTTP CONNECT proxies work; the credentials stay on this node.
# The hidden browser's connections go through the same proxy.
# SCARLETT_WEB_EGRESS_PROXY=http://user:pass@proxy.example:8080
# Web jobs in browser mode render protected pages in a hidden, sandboxed
# Chrome for Testing that the node downloads and verifies itself. On by
# default with web on macOS and Linux, off by default on Windows.
# SCARLETT_WEB_BROWSER=on
# Pages rendered at once, 1-4 and at most SCARLETT_WEB_CONCURRENCY. Unset:
# 1 below 16 GiB of memory, else 2.
# SCARLETT_WEB_BROWSER_CONCURRENCY=2
# How long an idle browser stays up, 30-3600 seconds.
# SCARLETT_WEB_BROWSER_IDLE_SECONDS=120
# SCARLETT_X_REFRESH_SECONDS=1800

# Default keeps conservative provider-window spreading
# quota_budget permits the fixed gap only with complete, same-operation
# headers above a 20% reserve (at least two requests)
# SCARLETT_X_PACING_MODE=conservative
