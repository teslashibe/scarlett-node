# Copy to ~/.config/scarlett-node/node.env and chmod 0600
# Choose your coordinator and verifier before starting
SCARLETT_COORDINATOR=https://network.scarlett.ai
SCARLETT_PROFILE=standard
SCARLETT_EXECUTOR=services
SCARLETT_SERVICES=codex,x_read
SCARLETT_VERIFIER=verifier.example.invalid:7047
# Optional private CA for the verifier control connection only
# SCARLETT_VERIFIER_CA_FILE=/absolute/path/to/verifier-ca.pem
# Absolute local credential paths, never node credentials or wallet private keys
# SCARLETT_CODEX_HOME=/home/you/.codex
# SCARLETT_X_SESSION=/home/you/.config/scarlett-node/x-session.json
# X jobs proven by keyed relay are ON by default (far less upload than
# MPC-TLS). The verifier then holds the TLS keys for your connection to X and
# decides what is sent with your session; you are trusting it with the
# account. Prefer an account kept for this purpose over a personal one. See
# README. Set to 0 to serve MPC-TLS only.
# SCARLETT_X_RELAY=0
SCARLETT_CODEX_CONCURRENCY=1
SCARLETT_X_CONCURRENCY=1
