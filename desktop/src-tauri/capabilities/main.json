{
  "identifier": "main",
  "description": "Local Scarlett window with fixed node commands",
  "windows": [
    "main"
  ],
  "permissions": [
    "allow-desktop-status",
    "allow-desktop-diagnostics",
    "allow-claude-status",
    "allow-quit-desktop",
    "allow-pair-node",
    "allow-control-node",
    "allow-open-network",
    "allow-connect-x",
    "allow-start-x-login",
    "allow-continue-x-login",
    "allow-cancel-x-login",
    "allow-browser-profiles",
    "allow-import-x-profile",
    "allow-reconnect-x",
    "allow-reimport-x-profile",
    "allow-resume-relay",
    "allow-connect-codex",
    "allow-remove-account",
    "allow-cancel-login",
    "allow-control-local-api",
    "allow-control-claude",
    "allow-local-api-key",
    "allow-desktop-preferences",
    "allow-save-desktop-preferences",
    "allow-desktop-autostart",
    "allow-set-desktop-autostart",
    "core:event:allow-listen",
    "core:event:allow-unlisten"
  ]
}
